{
    "ConnectionStrings": {
        /* מחרוזת החיבור לבסיס הנתונים SQL Server  */
        "DefaultConnection": ""
    },

    "Jwt": {
        /* המפתח הסודי שבאמצעותו השרת חותם על הטוקן - חייב להיות ארוך ומאובטח */
        "Key": "",

        /* מי הנפיק את הטוקן (במקרה זה, השרת שלך) */
        "Issuer": "TravelPlanner",

        /* למי הטוקן מיועד (קהל היעד/האפליקציה שלך) */
        "Audience": "TravelPlannerUsers",

        /* משך זמן התוקף של הטוקן בדקות (כאן הגדרנו שעה אחת) */
        "ExpiryInMinutes": 60
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "GoogleMaps": {
        "ApiKey": ""
    },
    "Gemini": {
        "ApiKey": ""
    },

    "AllowedHosts": "*"
}